StringTable {
 ItemClassName "CustomStringTableItem"
 Items {
  CustomStringTableItem "{651CA0823F62AF6E}" {
   Id "EXPBG-AIGlobalSkills_Description"
   Target_en_us "Global AI settings while this module exists: per-faction skill and aim accuracy with Rifleman, MG/LMG, Marksman and Leader overrides, default rules of engagement (per squad or soldier in the EXPBG Rules of Engagement tab of their Edit properties) and AI ammunition. Everything starts on vanilla. Place one; deleting the last module restores vanilla behaviour."
  }
  CustomStringTableItem "{80106D22C16A70A6}" {
   Id "EXPBG-AIGlobalSkills_Name"
   Target_en_us "AI Global Skills"
  }
  CustomStringTableItem "{59313D20DE5578BA}" {
   Id "EXPBG-BriefingBoard_Description"
   Target_en_us "Live briefing map. A player uses Brief on map: their map opens and their view, own markers and drawn lines appear on this board for everyone. Closing the map ends the briefing and frees the board."
  }
  CustomStringTableItem "{B1B390B3D6CFB84F}" {
   Id "EXPBG-BriefingBoard_Name"
   Target_en_us "Briefing Board"
  }
  CustomStringTableItem "{6922D03D8A11420A}" {
   Id "EXPBG-BriefingProjector_Description"
   Target_en_us "Live briefing map on a projector screen (Projector Screen model from Structures For GM byHeine by Heine.CRV, APL-SA). A player uses EXPBG: Brief on map: their map opens and their view, own markers and drawn lines appear on the screen for everyone nearby, in the in-game map style. Closing the map ends the briefing and frees the screen. The picture is on the side the roller case sticks out to; turn that side toward the audience."
  }
  CustomStringTableItem "{4BCC2E4F79149139}" {
   Id "EXPBG-BriefingProjector_Name"
   Target_en_us "Briefing Projector Screen"
  }
  CustomStringTableItem "{F873648171624059}" {
   Id "EXPBG-CacheZone_Description"
   Target_en_us "AI cache zone and owned-casualty cleanup. M.Pac and K.Edgar."
   Author "M.Pac and K.Edgar"
  }
  CustomStringTableItem "{B2780394F82C46D1}" {
   Id "EXPBG-CacheZone_Name"
   Target_en_us "AI Cache Zone"
   Author "M.Pac and K.Edgar"
  }
  CustomStringTableItem "{7A3E19C05B2D4F68}" {
   Id "EXPBG-MissionIntro_Description"
   Target_en_us "Each player sees a short intro once, when he first spawns in this game session (late joiners too): a black screen with the title, then the time, date and location, and the view fades back in. Set the title and location in its attributes; empty uses the mission name and the map grid. Place one; switch it off or delete it to stop new intros."
  }
  CustomStringTableItem "{2C8B6D41E09F3A57}" {
   Id "EXPBG-MissionIntro_Name"
   Target_en_us "Mission Intro"
  }
  CustomStringTableItem "{B462AC315D908000}" {
   Id "EXPBG-OptimizerController_Description"
   Target_en_us "Global controls for Unit Caching zones only. Enable all, disable all, or safely prepare all AI for saving."
   Author "M.Pac and K.Edgar"
  }
  CustomStringTableItem "{B462AC315D908001}" {
   Id "EXPBG-OptimizerController_Name"
   Target_en_us "UNIT CACHING CONTROLLER"
   Author "M.Pac and K.Edgar"
  }
  CustomStringTableItem "{CC2242A853709936}" {
   Id "EXPBG-ProtestZone_Description"
   Target_en_us "10-15 unarmed civilians in one group gather at the centre and protest in place: no roaming, raised-hand and pointing gestures, angry and rioting crowd audio from EXPBG Ambient Sounds (Crowd sound: Angry, Rioting or Alternate, the default). Protesters turn to face a player they can see within 40 m. Rotate the module to aim the crowd. Crowd and sound exist only while a player character is within the Wake distance (default 300 m); otherwise the zone sleeps and brings the same civilians back when a player returns. New zones start Off."
  }
  CustomStringTableItem "{0E85A79649558076}" {
   Id "EXPBG-ProtestZone_Name"
   Target_en_us "Civil Protest Zone"
  }
  CustomStringTableItem "{6E2B9A41D07C35F8}" {
   Id "EXPBG-RandomGarrison_Description"
   Target_en_us "Garrisons random buildings within its radius: choose Generate in its attributes and up to 32 buildings (count or share of the eligible ones) each get one to four random squads of one or two factions (one faction per building), away from players. Every squad is an ordinary EXPBG garrison with caching and is saved with the mission; Regenerate, Clear and Stop act on this zone's garrisons only."
  }
  CustomStringTableItem "{CEE956A82EA2D37E}" {
   Id "EXPBG-RandomGarrison_Name"
   Target_en_us "Random Garrison"
  }
  CustomStringTableItem "{9444A69B3D4A03FB}" {
   Id "EXPBG-SurrenderModule_Description"
   Target_en_us "Global module: AI squads that take heavy casualties may surrender. Prisoners drop their weapons, sit down and can be interrogated by players for squad positions or identity intel. Place one; every copy edits the same global settings."
  }
  CustomStringTableItem "{E511E0228F5B0D11}" {
   Id "EXPBG-SurrenderModule_Name"
   Target_en_us "AI Surrender"
  }
  CustomStringTableItem "{335D00FC99E43B2E}" {
   Id "EXPBG-TimeSkip_Description"
   Target_en_us "Time skip with a black screen: choose Skip time now in its attributes and every screen fades to black, shows the text (default 6 hours later) and the new time, the clock moves forward (the date rolls over) and the screens fade back in. Hours, minutes, fade times and text are set per module."
  }
  CustomStringTableItem "{4AFF57773C80B26C}" {
   Id "EXPBG-TimeSkip_Name"
   Target_en_us "Time Skip"
  }
  CustomStringTableItem "{5754BC2D7E10B5BB}" {
   Id "EXPBG-WeatherTransition_Description"
   Target_en_us "Blends the weather to a chosen target (clouds, rain, fog, wind) over 1-120 real minutes instead of switching at once. Pick the target and press Save to start; a new transition takes over smoothly from the current weather. While a module exists, weather picked in Scenario Properties also blends over its transition time (switchable)."
  }
  CustomStringTableItem "{3506A1595FB613AB}" {
   Id "EXPBG-WeatherTransition_Name"
   Target_en_us "Weather Transition"
  }
 }
}
